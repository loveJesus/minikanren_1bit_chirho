# Yosys Synthesis Script ☧
# Target: Generic (for resource estimation)

# Read Verilog
read_verilog -sv /tmp/domain_clean_chirho.v

# Elaborate
hierarchy -top main

# Synthesize
synth -top main

# Map to generic gates for resource counting
techmap

# Optimize
opt -full

# Print statistics
stat

# Write output
write_verilog /Volumes/ENC_4TB_WDB_CHIRHO/dev-aleluya/friends-aleluya/has-leluya/minikanren_1bit_chirho/synth_chirho/output_calyx_chirho.v
