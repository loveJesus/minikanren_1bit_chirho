// miniKanren Search Engine ☧
// Calyx IR for FPGA synthesis
//
// Complete search engine with:
// - N variable domains (64-bit each)
// - Parallel unification
// - Branching (fork) for choice points
// - Stack for backtracking

import "primitives/core.futil";
import "primitives/binary_operators.futil";
import "primitives/memories.futil";

// Search state: N variables with 64-bit domains
// Plus valid flag and branch point stack
// 8-variable search state (64-bit domains)
component search_state_chirho() -> () {
  cells {
    // Variable domains - using memory for N variables
    @external domains_chirho = seq_mem_d1(64, 8, 3);  // 8 vars, 64 bits each

    // Valid flag (0 = failed state)
    valid_chirho = std_reg(1);

    // Stack pointer for backtracking
    sp_chirho = std_reg(4);  // Max 16 stack entries

    // Constants
    one_chirho = std_const(1, 1);
    zero_chirho = std_const(1, 0);
    full_domain_chirho = std_const(64, 18446744073709551615);
  }

  wires {
    // Initialize all domains to full
    group init_state_chirho {
      valid_chirho.in = one_chirho.out;
      valid_chirho.write_en = 1'd1;
      sp_chirho.in = 4'd0;
      sp_chirho.write_en = 1'd1;
      init_state_chirho[done] = sp_chirho.done;
    }

    // Mark state as failed
    group fail_chirho {
      valid_chirho.in = zero_chirho.out;
      valid_chirho.write_en = 1'd1;
      fail_chirho[done] = valid_chirho.done;
    }
  }

  control {
    init_state_chirho;
  }
}

// Parallel unification unit for 2 variables
// Takes var indices, computes domain intersection
component unify_2_chirho() -> () {
  cells {
    // Variable indices
    var1_idx_chirho = std_reg(3);
    var2_idx_chirho = std_reg(3);

    // Domain memory (shared)
    @external domains_chirho = seq_mem_d1(64, 8, 3);

    // Loaded domains
    domain1_chirho = std_reg(64);
    domain2_chirho = std_reg(64);

    // Result
    result_chirho = std_reg(64);

    // AND for unification
    and_chirho = std_and(64);

    // Zero check for failure
    zero_chirho = std_const(64, 0);
    eq_chirho = std_eq(64);
    failed_chirho = std_reg(1);
  }

  wires {
    // Load domain 1
    group load_d1_chirho {
      domains_chirho.addr0 = var1_idx_chirho.out;
      domain1_chirho.in = domains_chirho.read_data;
      domain1_chirho.write_en = 1'd1;
      load_d1_chirho[done] = domain1_chirho.done;
    }

    // Load domain 2
    group load_d2_chirho {
      domains_chirho.addr0 = var2_idx_chirho.out;
      domain2_chirho.in = domains_chirho.read_data;
      domain2_chirho.write_en = 1'd1;
      load_d2_chirho[done] = domain2_chirho.done;
    }

    // Compute AND
    group compute_chirho {
      and_chirho.left = domain1_chirho.out;
      and_chirho.right = domain2_chirho.out;
      result_chirho.in = and_chirho.out;
      result_chirho.write_en = 1'd1;
      compute_chirho[done] = result_chirho.done;
    }

    // Check for failure
    group check_fail_chirho {
      eq_chirho.left = result_chirho.out;
      eq_chirho.right = zero_chirho.out;
      failed_chirho.in = eq_chirho.out;
      failed_chirho.write_en = 1'd1;
      check_fail_chirho[done] = failed_chirho.done;
    }

    // Write back to both variables
    group write_d1_chirho {
      domains_chirho.addr0 = var1_idx_chirho.out;
      domains_chirho.write_data = result_chirho.out;
      domains_chirho.write_en = 1'd1;
      write_d1_chirho[done] = domains_chirho.write_done;
    }

    group write_d2_chirho {
      domains_chirho.addr0 = var2_idx_chirho.out;
      domains_chirho.write_data = result_chirho.out;
      domains_chirho.write_en = 1'd1;
      write_d2_chirho[done] = domains_chirho.write_done;
    }
  }

  control {
    seq {
      par {
        load_d1_chirho;
        load_d2_chirho;
      }
      compute_chirho;
      check_fail_chirho;
      par {
        write_d1_chirho;
        write_d2_chirho;
      }
    }
  }
}

// Branch unit: fork state on a variable's possible values
// Creates two states: one with lowest bit set, one without
component branch_chirho() -> () {
  cells {
    // Variable to branch on
    var_idx_chirho = std_reg(3);

    // Current domain
    @external domains_chirho = seq_mem_d1(64, 8, 3);
    current_domain_chirho = std_reg(64);

    // Compute lowest set bit: x & (-x)
    neg_chirho = std_sub(64);
    zero_chirho = std_const(64, 0);
    and_chirho = std_and(64);
    lowest_bit_chirho = std_reg(64);

    // Compute domain without lowest bit: x & (x-1)
    one_chirho = std_const(64, 1);
    sub_one_chirho = std_sub(64);
    x_minus_1_chirho = std_reg(64);
    and2_chirho = std_and(64);
    rest_domain_chirho = std_reg(64);

    // Branch results
    branch_with_chirho = std_reg(64);    // Domain with only lowest bit
    branch_without_chirho = std_reg(64); // Domain without lowest bit
  }

  wires {
    // Load current domain
    group load_domain_chirho {
      domains_chirho.addr0 = var_idx_chirho.out;
      current_domain_chirho.in = domains_chirho.read_data;
      current_domain_chirho.write_en = 1'd1;
      load_domain_chirho[done] = current_domain_chirho.done;
    }

    // Compute lowest bit: x & (-x) = x & (0 - x)
    group compute_lowest_chirho {
      neg_chirho.left = zero_chirho.out;
      neg_chirho.right = current_domain_chirho.out;
      and_chirho.left = current_domain_chirho.out;
      and_chirho.right = neg_chirho.out;
      lowest_bit_chirho.in = and_chirho.out;
      lowest_bit_chirho.write_en = 1'd1;
      compute_lowest_chirho[done] = lowest_bit_chirho.done;
    }

    // Compute rest: x & (x-1)
    group compute_rest_chirho {
      sub_one_chirho.left = current_domain_chirho.out;
      sub_one_chirho.right = one_chirho.out;
      and2_chirho.left = current_domain_chirho.out;
      and2_chirho.right = sub_one_chirho.out;
      rest_domain_chirho.in = and2_chirho.out;
      rest_domain_chirho.write_en = 1'd1;
      compute_rest_chirho[done] = rest_domain_chirho.done;
    }

    // Store branch results
    group store_branches_chirho {
      branch_with_chirho.in = lowest_bit_chirho.out;
      branch_with_chirho.write_en = 1'd1;
      branch_without_chirho.in = rest_domain_chirho.out;
      branch_without_chirho.write_en = 1'd1;
      store_branches_chirho[done] = branch_without_chirho.done;
    }
  }

  control {
    seq {
      load_domain_chirho;
      par {
        compute_lowest_chirho;
        compute_rest_chirho;
      }
      store_branches_chirho;
    }
  }
}

// Backtrack stack entry
component stack_entry_chirho() -> () {
  cells {
    // Saved variable index
    var_idx_chirho = std_reg(3);

    // Saved alternative domain (the "without" branch)
    alt_domain_chirho = std_reg(64);

    // Valid bit
    valid_chirho = std_reg(1);
  }

  wires {
    group save_chirho<"promotable"=1> {
      var_idx_chirho.write_en = 1'd1;
      alt_domain_chirho.write_en = 1'd1;
      valid_chirho.in = 1'd1;
      valid_chirho.write_en = 1'd1;
      save_chirho[done] = valid_chirho.done;
    }

    group clear_chirho {
      valid_chirho.in = 1'd0;
      valid_chirho.write_en = 1'd1;
      clear_chirho[done] = valid_chirho.done;
    }
  }

  control {}
}

// Main search engine
component main() -> () {
  cells {
    // State
    state_chirho = search_state_chirho();

    // Unification unit
    unify_chirho = unify_2_chirho();

    // Branch unit
    branch_chirho = branch_chirho();

    // Solution counter
    solutions_chirho = std_reg(8);

    // Control registers
    running_chirho = std_reg(1);
    one_chirho = std_const(1, 1);
    zero_chirho = std_const(1, 0);
  }

  wires {
    group init_chirho {
      running_chirho.in = one_chirho.out;
      running_chirho.write_en = 1'd1;
      solutions_chirho.in = 8'd0;
      solutions_chirho.write_en = 1'd1;
      init_chirho[done] = solutions_chirho.done;
    }

    group stop_chirho {
      running_chirho.in = zero_chirho.out;
      running_chirho.write_en = 1'd1;
      stop_chirho[done] = running_chirho.done;
    }
  }

  control {
    seq {
      init_chirho;
      invoke state_chirho()();
      // Main search loop would go here
      // For now, just demonstrate components
      invoke unify_chirho()();
      invoke branch_chirho()();
      stop_chirho;
    }
  }
}
