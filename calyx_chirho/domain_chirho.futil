// Domain Operations for miniKanren ☧
// Calyx IR for FPGA synthesis
//
// A domain is a 64-bit bitmask where bit i=1 means value i is possible.
// Unification = AND of domains
// Disjunction = OR of domains

import "primitives/core.futil";
import "primitives/binary_operators.futil";

// Unification unit: AND two domains together
// This is the core operation: domain1 ∩ domain2
component unify_unit_chirho(
  @go go: 1,
  d1_chirho: 64,
  d2_chirho: 64
) -> (
  @done done: 1,
  result_chirho: 64,
  failed_chirho: 1
) {
  cells {
    // Result register
    result_reg_chirho = std_reg(64);

    // AND gate (64-bit parallel)
    and_gate_chirho = std_and(64);

    // Zero comparator for failure detection
    zero_chirho = std_const(64, 0);
    eq_chirho = std_eq(64);

    // Failure flag register
    failed_reg_chirho = std_reg(1);
  }

  wires {
    // Continuous output
    result_chirho = result_reg_chirho.out;
    failed_chirho = failed_reg_chirho.out;

    // Compute domain1 AND domain2
    group compute_and_chirho {
      and_gate_chirho.left = d1_chirho;
      and_gate_chirho.right = d2_chirho;
      result_reg_chirho.in = and_gate_chirho.out;
      result_reg_chirho.write_en = 1'd1;
      compute_and_chirho[done] = result_reg_chirho.done;
    }

    // Check if result is zero (failure)
    group check_failure_chirho {
      eq_chirho.left = result_reg_chirho.out;
      eq_chirho.right = zero_chirho.out;
      failed_reg_chirho.in = eq_chirho.out;
      failed_reg_chirho.write_en = 1'd1;
      check_failure_chirho[done] = failed_reg_chirho.done;
    }
  }

  control {
    seq {
      compute_and_chirho;
      check_failure_chirho;
    }
  }
}

// Disjunction unit: OR two domains (for conde)
component disj_unit_chirho(
  @go go: 1,
  d1_chirho: 64,
  d2_chirho: 64
) -> (
  @done done: 1,
  result_chirho: 64
) {
  cells {
    result_reg_chirho = std_reg(64);
    or_gate_chirho = std_or(64);
  }

  wires {
    result_chirho = result_reg_chirho.out;

    group compute_or_chirho {
      or_gate_chirho.left = d1_chirho;
      or_gate_chirho.right = d2_chirho;
      result_reg_chirho.in = or_gate_chirho.out;
      result_reg_chirho.write_en = 1'd1;
      compute_or_chirho[done] = result_reg_chirho.done;
    }
  }

  control {
    compute_or_chirho;
  }
}

// Singleton checker: is exactly one bit set?
// Uses: x & (x-1) == 0 AND x != 0
component singleton_check_chirho(
  @go go: 1,
  domain_chirho: 64
) -> (
  @done done: 1,
  is_singleton_chirho: 1
) {
  cells {
    // x & (x-1) == 0 means singleton (or zero)
    sub_one_chirho = std_sub(64);
    one_chirho = std_const(64, 1);
    and_chirho = std_and(64);
    zero_chirho = std_const(64, 0);
    eq_zero_chirho = std_eq(64);
    neq_zero_chirho = std_neq(64);

    // Result register
    result_reg_chirho = std_reg(1);

    // Temp registers
    x_minus_1_chirho = std_reg(64);
    and_result_chirho = std_reg(64);
    is_power_of_2_chirho = std_reg(1);
    is_nonzero_chirho = std_reg(1);

    // Final AND for result
    final_and_chirho = std_and(1);
  }

  wires {
    is_singleton_chirho = result_reg_chirho.out;

    // Compute x - 1
    group compute_sub_chirho {
      sub_one_chirho.left = domain_chirho;
      sub_one_chirho.right = one_chirho.out;
      x_minus_1_chirho.in = sub_one_chirho.out;
      x_minus_1_chirho.write_en = 1'd1;
      compute_sub_chirho[done] = x_minus_1_chirho.done;
    }

    // Compute x & (x-1)
    group compute_and_chirho {
      and_chirho.left = domain_chirho;
      and_chirho.right = x_minus_1_chirho.out;
      and_result_chirho.in = and_chirho.out;
      and_result_chirho.write_en = 1'd1;
      compute_and_chirho[done] = and_result_chirho.done;
    }

    // Check if x & (x-1) == 0
    group check_power2_chirho {
      eq_zero_chirho.left = and_result_chirho.out;
      eq_zero_chirho.right = zero_chirho.out;
      is_power_of_2_chirho.in = eq_zero_chirho.out;
      is_power_of_2_chirho.write_en = 1'd1;
      check_power2_chirho[done] = is_power_of_2_chirho.done;
    }

    // Check if x != 0
    group check_nonzero_chirho {
      neq_zero_chirho.left = domain_chirho;
      neq_zero_chirho.right = zero_chirho.out;
      is_nonzero_chirho.in = neq_zero_chirho.out;
      is_nonzero_chirho.write_en = 1'd1;
      check_nonzero_chirho[done] = is_nonzero_chirho.done;
    }

    // Final: is_singleton = is_power_of_2 AND is_nonzero
    group final_check_chirho {
      final_and_chirho.left = is_power_of_2_chirho.out;
      final_and_chirho.right = is_nonzero_chirho.out;
      result_reg_chirho.in = final_and_chirho.out;
      result_reg_chirho.write_en = 1'd1;
      final_check_chirho[done] = result_reg_chirho.done;
    }
  }

  control {
    seq {
      compute_sub_chirho;
      compute_and_chirho;
      par {
        check_power2_chirho;
        check_nonzero_chirho;
      }
      final_check_chirho;
    }
  }
}

// Branch unit: split domain into lowest bit and rest
// For search tree exploration
component branch_unit_chirho(
  @go go: 1,
  domain_chirho: 64
) -> (
  @done done: 1,
  lowest_bit_chirho: 64,
  rest_chirho: 64
) {
  cells {
    // lowest_bit = x & (-x) = x & (~x + 1)
    // rest = x & (x - 1)
    neg_chirho = std_sub(64);
    sub_chirho = std_sub(64);
    and1_chirho = std_and(64);
    and2_chirho = std_and(64);
    zero_chirho = std_const(64, 0);
    one_chirho = std_const(64, 1);

    lowest_reg_chirho = std_reg(64);
    rest_reg_chirho = std_reg(64);
    neg_x_chirho = std_reg(64);
    x_minus_1_chirho = std_reg(64);
  }

  wires {
    lowest_bit_chirho = lowest_reg_chirho.out;
    rest_chirho = rest_reg_chirho.out;

    // Compute -x = 0 - x
    group compute_neg_chirho {
      neg_chirho.left = zero_chirho.out;
      neg_chirho.right = domain_chirho;
      neg_x_chirho.in = neg_chirho.out;
      neg_x_chirho.write_en = 1'd1;
      compute_neg_chirho[done] = neg_x_chirho.done;
    }

    // Compute x - 1
    group compute_sub_chirho {
      sub_chirho.left = domain_chirho;
      sub_chirho.right = one_chirho.out;
      x_minus_1_chirho.in = sub_chirho.out;
      x_minus_1_chirho.write_en = 1'd1;
      compute_sub_chirho[done] = x_minus_1_chirho.done;
    }

    // Compute lowest_bit = x & (-x)
    group compute_lowest_chirho {
      and1_chirho.left = domain_chirho;
      and1_chirho.right = neg_x_chirho.out;
      lowest_reg_chirho.in = and1_chirho.out;
      lowest_reg_chirho.write_en = 1'd1;
      compute_lowest_chirho[done] = lowest_reg_chirho.done;
    }

    // Compute rest = x & (x - 1)
    group compute_rest_chirho {
      and2_chirho.left = domain_chirho;
      and2_chirho.right = x_minus_1_chirho.out;
      rest_reg_chirho.in = and2_chirho.out;
      rest_reg_chirho.write_en = 1'd1;
      compute_rest_chirho[done] = rest_reg_chirho.done;
    }
  }

  control {
    seq {
      par {
        compute_neg_chirho;
        compute_sub_chirho;
      }
      par {
        compute_lowest_chirho;
        compute_rest_chirho;
      }
    }
  }
}

// Main component: 4-variable search state demo
component main() -> () {
  cells {
    // 4 variable domains
    var0_chirho = std_reg(64);
    var1_chirho = std_reg(64);
    var2_chirho = std_reg(64);
    var3_chirho = std_reg(64);

    // Unification unit instance
    unify_chirho = unify_unit_chirho();

    // Full domain constant (all 1s)
    full_chirho = std_const(64, 18446744073709551615);

    // Test values
    test1_chirho = std_const(64, 255);   // 0xFF - values 0-7
    test2_chirho = std_const(64, 240);   // 0xF0 - values 4-7
  }

  wires {
    // Initialize all variables to full domain
    group init_vars_chirho {
      var0_chirho.in = full_chirho.out;
      var0_chirho.write_en = 1'd1;
      var1_chirho.in = full_chirho.out;
      var1_chirho.write_en = 1'd1;
      var2_chirho.in = full_chirho.out;
      var2_chirho.write_en = 1'd1;
      var3_chirho.in = full_chirho.out;
      var3_chirho.write_en = 1'd1;
      init_vars_chirho[done] = var3_chirho.done;
    }

    // Run unification: var0 = test1 AND test2
    group run_unify_chirho {
      unify_chirho.go = 1'd1;
      unify_chirho.d1_chirho = test1_chirho.out;
      unify_chirho.d2_chirho = test2_chirho.out;
      run_unify_chirho[done] = unify_chirho.done;
    }

    // Store result in var0
    group store_result_chirho {
      var0_chirho.in = unify_chirho.result_chirho;
      var0_chirho.write_en = 1'd1;
      store_result_chirho[done] = var0_chirho.done;
    }
  }

  control {
    seq {
      init_vars_chirho;
      run_unify_chirho;
      store_result_chirho;
    }
  }
}
