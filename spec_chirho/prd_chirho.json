        }
      },
      "rust_chirho/benches/": {
        "sygus_bench_chirho.rs": "SyGuS benchmarks",
        "comparison_bench_chirho.rs": "OCanren/faster-mk comparison",
        "gpu_bench_chirho.rs": "GPU vs CPU benchmarks",
        "differentiable_bench_chirho.rs": "Learning benchmarks"
      },
      "rust_chirho/examples/": {
        "learn_family_chirho.rs": "Family relations learning demo",
        "gpu_sudoku_chirho.rs": "Batch Sudoku on GPU",
        "sygus_max2_chirho.rs": "SyGuS synthesis demo"
      },
      "benchmarks_chirho/": {
        "sygus/": {
          "max2.sl": "Conditional max problem",
          "array_search.sl": "Array search problem",
          "string_replace.sl": "String manipulation"
        },
        "ocanren/": {
          "appendo_chirho.ml": "OCanren appendo",
          "nqueens_chirho.ml": "OCanren N-Queens"
        },
        "faster/": {
          "appendo_chirho.scm": "faster-miniKanren appendo",
          "nqueens_chirho.scm": "faster-miniKanren N-Queens"
        },
        "scripts/": {
