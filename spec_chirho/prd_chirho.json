{
  "title_chirho": "miniKanren 1-Bit: Paper-Ready Benchmarks & Applications",
  "version_chirho": "1.0.0",
  "description_chirho": "Complete the miniKanren 1-bit matrix operations project with publishable benchmarks, GPU integration, and differentiable logic applications",

  "core_principle_chirho": "All logic operations reduce to sparse Boolean tensor network contraction, enabling hardware acceleration via SIMD, GPU, and FPGA",

  "existing_codebase_chirho": {
    "rust_library_chirho": "rust_chirho/src/",
    "key_modules_chirho": [
      "hardware_chirho.rs - BitVec64Chirho, BitVec256Chirho, CAM",
      "approaches_chirho/ - Hierarchical4kChirho, Hierarchical256kChirho, SymbolicDomainChirho",
      "diff_semiring_chirho.rs - DiffProbChirho, soft logic",
      "semiring_chirho.rs - Bool/Prob/Tropical/Count semirings",
      "goals_chirho.rs - eq, conde, fresh, not, conda, condu, diseq",
      "unify_chirho.rs - unification with occurs check",
      "sudoku_chirho.rs - constraint propagation solver"
    ],
    "gpu_feature_chirho": "gpu_chirho feature flag (wgpu, pollster, bytemuck)",
    "benchmarks_chirho": [
      "benches/synthesis_bench_chirho.rs - type inference, synthesis enumeration",
      "benches/approaches_bench_chirho.rs - domain comparison",
      "benches/criterion_bench_chirho.rs - core operations"
    ]
  },

  "directory_structure_chirho": {
    "description_chirho": "Keep main src/ clean, organize new code in submodules",
    "layout_chirho": {
      "rust_chirho/src/": {
        "lib.rs": "Main exports - add mod declarations only",
        "synthesis_chirho/": {
          "mod.rs": "Synthesis submodule",
          "sygus_chirho.rs": "SyGuS parser",
          "grammar_chirho.rs": "Grammar domain encoding",
          "enumerate_chirho.rs": "Domain-pruned enumeration"
        },
        "learn_chirho/": {
          "mod.rs": "Differentiable learning submodule",
          "learnable_chirho.rs": "LearnableRelationChirho",
          "anneal_chirho.rs": "Temperature annealing",
          "gumbel_chirho.rs": "Gumbel-softmax"
        },
        "gpu_chirho/": {
          "mod.rs": "GPU submodule (extends existing)",
          "pipeline_chirho.rs": "WebGPU pipeline",
          "shaders_chirho/": {
            "domain_intersect_chirho.wgsl": "Batch intersection",
            "batch_unify_chirho.wgsl": "Parallel unification",
            "arc_consistency_chirho.wgsl": "Constraint propagation"
