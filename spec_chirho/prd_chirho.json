  "coding_standards_chirho": {
    "suffix_chirho": "ALL identifiers must end with _chirho (variables, functions, types)",
    "casing_chirho": {
      "types_chirho": "PascalChirho (e.g., BitVec64Chirho)",
      "functions_chirho": "snake_chirho (e.g., unify_chirho)",
      "variables_chirho": "snake_chirho (e.g., result_chirho)",
      "constants_chirho": "UPPER_CHIRHO (e.g., MAX_DEPTH_CHIRHO)"
    },
    "integration_chirho": "New code must use existing library types (BitVec64Chirho, Hierarchical4kChirho, DiffProbChirho)"
  },

  "architecture_constraints_chirho": [
    "Domain operations must reduce to bitwise AND/OR on BitVec64Chirho or hierarchical variants",
    "GPU shaders must mirror CPU algorithms exactly for verification",
    "Differentiable logic must use DiffProbChirho semiring from diff_semiring_chirho.rs",
    "All benchmarks must use criterion for consistent measurement",
    "New modules go in submodules (synthesis_chirho/, learn_chirho/, gpu_chirho/) not main src/"
  ],

  "success_metrics_chirho": {
    "sygus_chirho": "10x faster than CVC5 on 2+ problems",
    "ocanren_comparison_chirho": "10x faster than OCanren on 2+ benchmarks",
    "gpu_speedup_chirho": "10x faster than CPU at batch size 100k",
    "differentiable_chirho": "Training converges in <1000 iterations",
    "paper_chirho": "Accepted at miniKanren Workshop or ICFP"
  },

  "paper_reproducibility_chirho": {
    "requirement_chirho": "Paper must be self-contained enough that an LLM could reconstruct the code and reproduce results",
    "mandatory_content_chirho": [
      {
        "section_chirho": "Data Structures",
        "content_chirho": "Complete type definitions with field layouts (BitVec64Chirho = u64 wrapper, Hierarchical4kChirho = root BitVec64 + 64 leaf BitVec64s)"
      },
      {
        "section_chirho": "Algorithms",
        "content_chirho": "Pseudocode or actual code for: domain intersection, hierarchical early-exit, unification with occurs check, constraint propagation"
      },
      {
        "section_chirho": "Mathematical Formulation",
        "content_chirho": "Formal definitions: domain as bitmask, unification as AND, disjunction as tensor stack, soft equality formula exp(-|a-b|/τ)"
      },
      {
        "section_chirho": "GPU Shaders",
        "content_chirho": "Complete WGSL code for domain intersection kernel (small enough to include verbatim)"
      },
      {
        "section_chirho": "Benchmark Methodology",
        "content_chirho": "Exact benchmark parameters: sample sizes, warmup, input generation seeds, hardware specs"
      },
      {
        "section_chirho": "Test Cases",
        "content_chirho": "Concrete examples with expected outputs: Sudoku puzzle input/solution, N-Queens expected count, SyGuS I/O examples"
      }
    ],
    "appendix_chirho": [
      "Full Rust type definitions for all domain types",
      "Complete WGSL shader source code",
      "SyGuS .sl file format examples",
      "Benchmark input generation code"
    ],
    "verification_chirho": "Before submission, test that paper content alone (without repo access) enables reimplementation"
  }
}
